# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Retell API key (dashboard > Settings > API Keys)
RETELL_API_KEY=

# Filled in by `npm run retell:setup`
RETELL_LLM_ID=
RETELL_AGENT_ID=
# A number you bought or imported in Retell, E.164 format, e.g. +19165550100
RETELL_FROM_NUMBER=

# Test mode: when set, every call rings this number (e.g. your cell) instead of the real office.
# Leave empty to call the provider's real office number.
RETELL_TEST_TO_NUMBER=
